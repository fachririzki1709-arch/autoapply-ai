<%- include('partials/head', { pageTitle: 'Gudang Dokumen & Preset Bundel — AutoApply AI v3.0' }) %>

<div class="min-h-screen flex flex-col lg:flex-row">
  <%- include('partials/sidebar', { activePage: 'documents' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('partials/topbar', { profile }) %>

    <main class="p-5 space-y-5 max-w-[1440px] w-full mx-auto">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-[20px] font-bold text-[#EADCC8]">Gudang Dokumen PDF &amp; Preset Bundel Peran</h2>
          <p class="text-[12px] text-[#7FB3B8]">
            Penyimpanan persisten MongoDB GridFS • Auto-Merge (pdf-lib) &amp; Kompresi Otomatis &le; 2 MB (150 DPI)
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-doc-tab="files"
            class="px-4 py-2 rounded-xl text-[12px] font-semibold bg-[#C6601F] text-[#EADCC8]"
          >
            Tab 1: Daftar File PDF (<%= assets.length %>)
          </button>
          <button
            type="button"
            data-doc-tab="presets"
            class="px-4 py-2 rounded-xl text-[12px] font-semibold bg-[#0A0F14] text-[#7FB3B8] border border-[#7FB3B8]/25"
          >
            Tab 2: Preset Bundel Peran (<%= presets.length %>)
          </button>
        </div>
      </div>

      <!-- TAB 1: DAFTAR FILE PDF INDIVIDU -->
      <div id="tabFilesPanel" class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- Upload Form -->
        <div class="lg:col-span-4 rounded-2xl bento-card p-5 h-fit">
          <h3 class="text-[16px] font-semibold text-[#EADCC8] mb-3">Unggah Dokumen PDF Baru</h3>
          <form id="uploadPdfForm" class="space-y-3.5">
            <div>
              <label class="block text-[12px] text-[#7FB3B8] mb-1">Judul Dokumen</label>
              <input
                type="text"
                name="title"
                required
                placeholder="Misal: CV Admin Logistik / Ijazah / KTP"
                class="w-full rounded-xl px-3 py-2 text-[13px] input-obsidian"
              />
            </div>

            <div>
              <label class="block text-[12px] text-[#7FB3B8] mb-1">Kategori Dokumen</label>
              <select name="category" class="w-full rounded-xl px-3 py-2 text-[13px] input-obsidian">
                <option value="cv_variant">Varian CV (cv_variant — Diekstrak AI)</option>
                <option value="cover_letter">Surat Lamaran (cover_letter)</option>
                <option value="diploma">Ijazah (diploma)</option>
                <option value="transcript">Transkrip Nilai (transcript)</option>
                <option value="certificate">Sertifikat Keahlian (certificate)</option>
                <option value="identity">Identitas KTP/NPWP/SKCK (identity)</option>
                <option value="portfolio">Portofolio (portfolio)</option>
                <option value="other">Lainnya (other)</option>
              </select>
            </div>

            <div>
              <label class="block text-[12px] text-[#7FB3B8] mb-1">Pilih Berkas PDF</label>
              <input
                type="file"
                name="pdfFile"
                accept="application/pdf"
                required
                class="w-full text-[12px] text-[#7FB3B8]"
              />
            </div>

            <button type="submit" class="w-full py-2.5 rounded-xl btn-amber text-[13px]">
              Unggah ke GridFS
            </button>
          </form>
        </div>

        <!-- Uploaded Assets List -->
        <div class="lg:col-span-8 space-y-3">
          <% if (assets.length === 0) { %>
          <div class="rounded-2xl bento-card p-8 text-center text-[13px] text-[#7FB3B8]">
            Belum ada berkas PDF di GridFS. Unggah varian CV dan dokumen pendukung Anda di panel kiri.
          </div>
          <% } %>

          <% assets.forEach((doc) => { %>
          <div class="rounded-2xl bento-card p-4 flex flex-wrap items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="px-2.5 py-0.5 rounded text-[10px] font-mono uppercase bg-[#2E6F73]/50 text-[#EADCC8]">
                  <%= doc.category %>
                </span>
                <span class="text-[11px] font-mono text-[#7FB3B8]">
                  <%= doc.pageCount %> hal • <%= Math.round(doc.fileSizeBytes / 1024) %> KB
                </span>
              </div>
              <h4 class="text-[15px] font-semibold text-[#EADCC8]"><%= doc.title %></h4>
              <p class="text-[12px] text-[#7FB3B8]"><%= doc.originalFileName %></p>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                data-preview-extracted
                data-doc-title="<%= doc.title %>"
                data-extracted-text="<%= doc.extractedText || '' %>"
                class="px-3 py-1.5 rounded-xl btn-lagoon text-[12px]"
              >
                Pratinjau Teks AI
              </button>
              <a
                href="/api/files/gridfs/<%= doc.storageFileId %>"
                target="_blank"
                class="px-3 py-1.5 rounded-xl bg-[#0A0F14] border border-[#7FB3B8]/25 text-[12px] text-[#EADCC8]"
              >
                Lihat PDF
              </a>
              <button
                type="button"
                data-delete-doc="<%= doc._id %>"
                class="px-3 py-1.5 rounded-xl bg-red-950/70 border border-red-500/40 text-[12px] text-red-200"
              >
                Hapus
              </button>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- TAB 2: PRESET BUNDEL PERAN (AUTO-MERGE + KOMPRESI <= 2 MB) -->
      <div id="tabPresetsPanel" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-5">
        <div class="lg:col-span-5 rounded-2xl bento-card p-5 h-fit">
          <h3 class="text-[16px] font-semibold text-[#EADCC8] mb-3">Buat Preset Bundel Peran</h3>
          <form id="createPresetForm" class="space-y-3.5">
            <div>
              <label class="block text-[12px] text-[#7FB3B8] mb-1">Nama Preset Karier</label>
              <input
                type="text"
                name="presetName"
                required
                placeholder="Misal: Paket Administrasi & Logistik"
                class="w-full rounded-xl px-3 py-2 text-[13px] input-obsidian"
              />
            </div>

            <div>
              <label class="block text-[12px] text-[#7FB3B8] mb-1">Nama File PDF Gabungan</label>
              <input
                type="text"
                name="mergedFileName"
                required
                placeholder="Berkas_Lamaran_Admin_Kandidat.pdf"
                class="w-full rounded-xl px-3 py-2 text-[13px] input-obsidian"
              />
            </div>

            <div>
              <label class="block text-[12px] text-[#7FB3B8] mb-1">Kata Kunci Peran (Pisahkan Koma)</label>
              <input
                type="text"
                name="roleKeywords"
                placeholder="Admin, Logistik, Transport, Gudang, SAP"
                class="w-full rounded-xl px-3 py-2 text-[13px] input-obsidian"
              />
            </div>

            <div>
              <label class="block text-[12px] text-[#7FB3B8] mb-1.5">Pilih Dokumen &amp; Urutan Halaman (mergeOrder)</label>
              <div class="space-y-2 max-h-56 overflow-y-auto p-2.5 rounded-xl bg-[#0A0F14] border border-[#7FB3B8]/20">
                <% assets.forEach((doc, idx) => { %>
                <div class="flex items-center justify-between gap-2 text-[12px]">
                  <label class="flex items-center gap-2 cursor-pointer text-[#EADCC8]">
                    <input type="checkbox" data-preset-doc-check value="<%= doc._id %>" class="accent-[#C6601F]" />
                    <span><%= doc.title %> (<%= doc.category %>)</span>
                  </label>
                  <input
                    type="number"
                    min="1"
                    value="<%= idx + 1 %>"
                    data-preset-doc-order="<%= doc._id %>"
                    class="w-14 px-2 py-1 rounded bg-[#0F3D3E] text-center font-mono text-[11px] text-[#EADCC8]"
                  />
                </div>
                <% }) %>
              </div>
            </div>

            <label class="flex items-center gap-2 text-[12px] text-[#7FB3B8] cursor-pointer">
              <input type="checkbox" name="isDefault" class="accent-[#C6601F]" />
              <span>Jadikan Preset Utama (Default)</span>
            </label>

            <button type="submit" class="w-full py-2.5 rounded-xl btn-amber text-[13px]">
              Simpan &amp; Build PDF Terkompresi
            </button>
          </form>
        </div>

        <div class="lg:col-span-7 space-y-3">
          <% presets.forEach((preset) => { %>
          <% const sizeKB = Math.round((preset.compressedSizeBytes || 0) / 1024); %>
          <% const isUnder2MB = (preset.compressedSizeBytes || 0) <= 2097152; %>
          <div class="rounded-2xl bento-card p-5 space-y-3">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <h4 class="text-[16px] font-semibold text-[#EADCC8]"><%= preset.presetName %></h4>
                  <% if (preset.isDefault) { %>
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#C6601F] text-[#EADCC8]">DEFAULT</span>
                  <% } %>
                </div>
                <p class="text-[12px] font-mono text-[#7FB3B8]"><%= preset.mergedFileName %></p>
              </div>

              <span
                class="px-3 py-1 rounded-xl text-[11px] font-mono font-semibold border <%= isUnder2MB ? 'bg-emerald-950/70 border-emerald-500/40 text-emerald-300' : 'bg-amber-950/70 border-amber-500/40 text-amber-300' %>"
              >
                <%= preset.totalPages %> Hal • <%= sizeKB %> KB (<%= isUnder2MB ? 'Optimal <= 2MB' : '> 2MB' %>)
              </span>
            </div>

            <div class="flex flex-wrap gap-1.5">
              <% (preset.orderedDocuments || []).sort((a,b) => a.order - b.order).forEach((item) => { %>
              <span class="px-2.5 py-1 rounded-lg text-[11px] bg-[#0A0F14] text-[#EADCC8]/90 border border-[#7FB3B8]/20">
                <%= item.order %>. <%= item.documentId?.title || 'Dokumen' %>
              </span>
              <% }) %>
            </div>

            <div class="flex items-center gap-2 pt-2 border-t border-[#7FB3B8]/15">
              <% if (preset.mergedStorageFileId) { %>
              <a
                href="/api/files/gridfs/<%= preset.mergedStorageFileId %>?download=1"
                class="px-3.5 py-1.5 rounded-xl btn-amber text-[12px]"
              >
                Unduh PDF Gabungan
              </a>
              <a
                href="/api/files/gridfs/<%= preset.mergedStorageFileId %>"
                target="_blank"
                class="px-3.5 py-1.5 rounded-xl btn-lagoon text-[12px]"
              >
                Pratinjau
              </a>
              <% } %>
              <button
                type="button"
                data-rebuild-preset="<%= preset._id %>"
                class="px-3 py-1.5 rounded-xl bg-[#0A0F14] border border-[#7FB3B8]/25 text-[12px] text-[#7FB3B8]"
              >
                Build Ulang
              </button>
              <button
                type="button"
                data-delete-preset="<%= preset._id %>"
                class="px-3 py-1.5 rounded-xl bg-red-950/60 border border-red-500/40 text-[12px] text-red-200"
              >
                Hapus
              </button>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Modal Pratinjau Hasil Ekstraksi Teks CV (pdf-parse) -->
<div id="extractedTextModal" class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="w-full max-w-2xl rounded-2xl bg-[#0F3D3E] border border-[#7FB3B8]/35 p-6">
    <div class="flex items-center justify-between pb-3 border-b border-[#7FB3B8]/20">
      <h3 id="extractedModalTitle" class="text-[16px] font-semibold text-[#EADCC8]">Hasil Ekstraksi Teks</h3>
      <button id="closeExtractedModal" class="text-[#7FB3B8] hover:text-[#EADCC8]">✕</button>
    </div>
    <pre
      id="extractedModalBody"
      class="mt-4 p-4 rounded-xl bg-[#0A0F14] text-[12px] text-[#EADCC8]/90 font-mono whitespace-pre-wrap max-h-96 overflow-y-auto"
    ></pre>
  </div>
</div>

<%- include('partials/quick-capture-modal') %>
<script src="/js/motion.js"></script>
<script src="/js/documents.js"></script>
</body>
</html>